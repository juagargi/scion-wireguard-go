      "description": "State of every workload over time: pending (gray), running (blue), passed (green), failed (red).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": 90000
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "pending",
                  "color": "text",
                  "index": 0
                },
                "1": {
                  "text": "running",
                  "color": "blue",
                  "index": 1
                },
                "2": {
                  "text": "passed",
                  "color": "green",
                  "index": 2
                },
                "3": {
                  "text": "failed",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
