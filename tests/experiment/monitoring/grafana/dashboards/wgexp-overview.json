      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Workload start/end",
        "expr": "changes(wgexp_workload_state{tunnel=~\"$tunnel\"}[30s]) > 0",
        "step": "30s",
        "titleFormat": "{{workload}}",
        "textFormat": "{{kind}} {{from}}->{{to}}: state changed"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "tunnel",
        "label": "tunnel",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(wireguard_sent_bytes_total, tunnel)",
          "refId": "tunnel"
        },
        "definition": "label_values(wireguard_sent_bytes_total, tunnel)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Underlay bytes sent and received by each wireguard-go endpoint (SCION and UDP headers included).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "id": 101,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (tunnel, endpoint) (rate(wireguard_sent_bytes_total{tunnel=~\"$tunnel\"}[$__rate_interval]))*8",
          "legendFormat": "{{tunnel}} {{endpoint}} sent",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (tunnel, endpoint) (rate(wireguard_received_bytes_total{tunnel=~\"$tunnel\"}[$__rate_interval]))*8",
          "legendFormat": "{{tunnel}} {{endpoint}} received",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Traffic rate per endpoint",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Bytes one endpoint sent minus what its peer received, per direction: loss on the path or in the border routers. Peer label is mapped to endpoint.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "id": 102,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (tunnel, endpoint) (rate(wireguard_sent_bytes_total{tunnel=~\"$tunnel\"}[$__rate_interval]))*8 - on (tunnel, endpoint) sum by (tunnel, endpoint) (label_replace(rate(wireguard_received_bytes_total{tunnel=~\"$tunnel\"}[$__rate_interval]), \"endpoint\", \"$1\", \"peer\", \"(.*)\"))*8",
          "legendFormat": "{{tunnel}} {{endpoint}} to peer",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Send-receive gap per direction",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
